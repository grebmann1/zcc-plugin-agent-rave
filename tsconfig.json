{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "*.test.ts",
    "*.test.tsx",
    "vitest.config.ts"
  ]
}
